// The first screen: the summary strip, the restored-jobs note, one card per job, and the drop
// zone when the queue is empty.

import { ListView } from "std-widgets.slint";
import { Theme, Type, Icons, Icon, Chamfer, Button, ButtonKind, IconButton, ProgressBar, SectionLabel } from "@vibeware";
import { JobRow, Tile, Fmt } from "types.slint";
import { AppIcons, States } from "glyph.slint";

// One number of the summary (VibeFTP's tile: a mono caption, the value under it).
component TileBox inherits Chamfer {
    in property <Tile> tile;
    fill: Theme.surface;
    stroke: Theme.line;
    height: 44px;
    min-width: 92px;
    horizontal-stretch: 1;
    max-width: 150px;
    accessible-role: text;
    accessible-label: root.tile.caption + " " + root.tile.value;
    accessible-description: root.tile.value;
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        spacing: 1px;
        Text { text: root.tile.caption; accessible-role: none; font-family: Type.mono; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
        Text {
            text: root.tile.value;
            accessible-role: none;
            font-size: Type.body;
            font-weight: Type.strong;
            color: root.tile.alert ? Theme.danger-text : Theme.ink;
            overflow: elide;
        }
    }
}

export component Summary inherits Rectangle {
    in property <[Tile]> tiles;
    in property <bool> can-clear;
    in property <bool> inert;
    callback clear-finished();
    height: 64px;
    background: Theme.bg;
    accessible-role: groupbox;
    accessible-label: "Summary";
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        for t in root.tiles: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            max-width: 150px;
            TileBox { tile: t; }
        }
        Rectangle { horizontal-stretch: 1; min-width: 0px; }
        if root.can-clear: VerticalLayout {
            alignment: center;
            Button {
                inert: root.inert;
                text: "Clear finished";
                kind: ButtonKind.ghost;
                tooltip: "Take finished jobs off the list";
                clicked => { root.clear-finished(); }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// Where the files go: an arrow and the folder, elided in the middle. Its size never depends
// on its text (no binding loop).
export component Route inherits Rectangle {
    in property <string> dest;
    in property <string> mode;
    min-width: 80px;
    preferred-width: 200px;
    height: 18px;
    Icon { x: 0; y: 1px; path: AppIcons.arrow-right; tint: Theme.ink-3; }
    Text {
        x: 22px;
        width: Math.max(0px, root.width - self.x);
        text: Fmt.elide(root.dest, Math.max(8, Math.floor(self.width / Fmt.mono-advance)));
        accessible-role: none;
        font-family: Type.mono;
        font-size: Type.small;
        color: Theme.ink-2;
        vertical-alignment: center;
    }
}

component JobCard inherits Rectangle {
    in property <JobRow> job;
    in property <bool> inert;
    callback open();
    callback pause();
    callback resume();
    callback cancel();
    callback remove();
    callback reveal();
    callback menu(length, length);

    height: 80px;
    // One accessibility node for the card; its buttons are nodes of their own.
    accessible-role: list-item;
    accessible-label: root.job.title;
    accessible-description: root.job.word + (root.job.numbers != "" ? ". " + root.job.numbers : "");
    accessible-action-default => { root.open(); }

    property <color> signal: States.colour(root.job.state);

    Chamfer {
        width: 100%;
        height: 100%;
        fill: ta.has-hover ? Theme.surface-2 : Theme.surface;
        stroke: ta.has-hover ? Theme.line-strong : Theme.line;
        Rectangle { x: 0; width: 2px; background: root.job.state == 0 ? transparent : root.signal; }
    }
    ta := TouchArea { clicked => { root.open(); } }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-bottom: 3px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon { path: States.icon(root.job.state); tint: root.signal; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 140px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.job.title; accessible-role: none; font-size: Type.small; font-weight: Type.strong; color: Theme.ink; overflow: elide; horizontal-stretch: 1; }
            }
            Route { dest: root.job.dest; mode: root.job.mode; }
            Text { text: root.job.current; accessible-role: none; font-family: Type.mono; font-size: Type.small; color: root.job.state == 3 ? Theme.warn-text : Theme.ink-3; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            width: 240px;
            Text {
                text: root.job.word;
                accessible-role: none;
                font-size: Type.small;
                font-weight: Type.strong;
                color: root.job.state == 0 || root.job.state == 5 || root.job.state == 6 ? Theme.ink-2 : Theme.as-text(root.signal);
                overflow: elide;
            }
            Text { text: root.job.numbers; accessible-role: none; font-family: Type.mono; font-size: Type.small; color: Theme.ink-2; overflow: elide; }
            Text { text: root.job.speed; accessible-role: none; font-family: Type.mono; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
        }
        HorizontalLayout {
            spacing: 2px;
            width: 4 * 28px + 3 * 2px;
            VerticalLayout {
                alignment: center;
                if root.job.can-pause: IconButton {
                    inert: root.inert;
                    icon: Icons.pause;
                    label: "Pause " + root.job.title;
                    tooltip: "Pause (stops inside the file; resume goes on from there)";
                    clicked => { root.pause(); }
                }
                if root.job.can-resume: IconButton {
                    inert: root.inert;
                    icon: AppIcons.play;
                    label: "Resume " + root.job.title;
                    tooltip: "Resume";
                    clicked => { root.resume(); }
                }
                if !root.job.can-pause && !root.job.can-resume: Rectangle { width: 28px; }
            }
            VerticalLayout {
                alignment: center;
                if root.job.can-cancel: IconButton {
                    inert: root.inert;
                    icon: Icons.stop;
                    label: "Cancel " + root.job.title;
                    tooltip: "Cancel (what is copied stays; the file in progress is removed)";
                    clicked => { root.cancel(); }
                }
                if root.job.finished: IconButton {
                    inert: root.inert;
                    icon: Icons.x;
                    label: "Remove " + root.job.title;
                    tooltip: "Take it off the list";
                    clicked => { root.remove(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    inert: root.inert;
                    icon: Icons.folder-open;
                    label: "Open destination of " + root.job.title;
                    tooltip: "Open the destination";
                    clicked => { root.reveal(); }
                }
            }
            VerticalLayout {
                alignment: center;
                mb := IconButton {
                    inert: root.inert;
                    icon: Icons.menu;
                    label: root.job.title + " menu";
                    tooltip: "More";
                    clicked => { root.menu(mb.absolute-position.x + mb.width, mb.absolute-position.y + mb.height); }
                }
            }
        }
    }
    if root.job.progress > -1.5: ProgressBar {
        x: 2px;
        y: parent.height - 4px;
        width: parent.width - 4px;
        value: root.job.progress;
    }
}

export component JobList inherits Rectangle {
    in property <[JobRow]> jobs;
    in property <bool> inert;
    // "2 jobs were left unfinished..." (empty: no note).
    in property <string> restored;
    callback open(int);
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback remove(int);
    callback reveal(int);
    callback menu(int, length, length);
    callback resume-restored();
    callback discard-restored();

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        spacing: 4px;
        if root.restored != "": Rectangle {
            height: 48px;
            accessible-role: groupbox;
            accessible-label: "Unfinished jobs";
            Chamfer {
                width: 100%;
                height: 100%;
                fill: Theme.accent-soft;
                stroke: Theme.accent.with-alpha(0.5);
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon { path: Icons.info; tint: Theme.accent; }
                }
                Text {
                    text: root.restored;
                    color: Theme.ink;
                    font-size: Type.small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button { inert: root.inert; text: "Discard"; kind: ButtonKind.ghost; label: "Discard unfinished jobs"; tooltip: "Remove them (copied files stay; parts are deleted)"; clicked => { root.discard-restored(); } }
                }
                VerticalLayout {
                    alignment: center;
                    Button { inert: root.inert; text: "Resume"; icon: AppIcons.play; kind: ButtonKind.primary; label: "Resume unfinished jobs"; clicked => { root.resume-restored(); } }
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for j[i] in root.jobs: Rectangle {
                height: 88px;
                JobCard {
                    y: 4px;
                    width: parent.width;
                    job: j;
                    inert: root.inert;
                    open => { root.open(i); }
                    pause => { root.pause(i); }
                    resume => { root.resume(i); }
                    cancel => { root.cancel(i); }
                    remove => { root.remove(i); }
                    reveal => { root.reveal(i); }
                    menu(x, y) => { root.menu(i, x, y); }
                }
            }
        }
    }
}

// Nothing in the queue: where to drop, or how to paste.
export component DropZone inherits Rectangle {
    in property <bool> inert;
    in property <bool> hover;
    callback paste();
    accessible-role: groupbox;
    accessible-label: "Drop files here";
    Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        Chamfer {
            width: 100%;
            height: 100%;
            cut: Theme.cut;
            fill: root.hover ? Theme.accent-soft : transparent;
            stroke: root.hover ? Theme.accent : Theme.line-strong;
        }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Icon { size: 32px; path: Icons.copy; tint: root.hover ? Theme.accent : Theme.ink-3; }
            }
            Rectangle { height: 2px; }
            Text {
                text: "Drop files and folders here";
                horizontal-alignment: center;
                font-size: Type.body;
                font-weight: Type.strong;
                color: Theme.ink;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: 440px;
                    text: "or copy them in Explorer and paste here (Ctrl+V). Then pick where they go. Copies and moves wait their turn per drive, can be paused, and every file can be checked.";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    min-height: self.preferred-height; // the window shows this through `if` (Slint 1.18.1)
                    font-size: Type.small;
                    color: Theme.ink-3;
                }
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                alignment: center;
                Button { inert: root.inert; text: "Paste"; icon: AppIcons.paste; kind: ButtonKind.primary; label: "Paste files"; tooltip: "Paste files copied in Explorer (Ctrl+V)"; clicked => { root.paste(); } }
            }
        }
    }
}
