// VibeCopy's own icons (VibeWare's 16 grid, 1-unit strokes, 0/45/90 degrees) and the state
// colours and symbols of jobs and files.

import { Theme, Icons } from "@vibeware";

export global AppIcons {
    // Resume: a 45-degree play mark.
    out property <string> play: "M 5.5 3.5 L 10.5 8.5 L 5.5 13.5 Z";
    out property <string> back: "M 14 8.5 L 3 8.5 M 7 4.5 L 3 8.5 L 7 12.5";
    out property <string> arrow-right: "M 3 8.5 L 14 8.5 M 10 4.5 L 14 8.5 L 10 12.5";
    // Paste: the clipboard board and its clip.
    out property <string> paste: "M 3.5 3.5 L 13.5 3.5 L 13.5 14.5 L 3.5 14.5 Z M 6.5 2.5 L 10.5 2.5 L 10.5 4.5 L 6.5 4.5 Z M 6 8.5 L 11 8.5 M 6 11.5 L 9 11.5";
    // Queued: an octagonal clock.
    out property <string> clock: "M 5.5 2.5 L 11.5 2.5 L 14.5 5.5 L 14.5 11.5 L 11.5 14.5 L 5.5 14.5 L 2.5 11.5 L 2.5 5.5 Z M 8.5 5 L 8.5 8.5 L 11 11";
    // Retry: refresh, the arrow at its end.
    out property <string> retry: "M 10.5 3.5 L 6.5 3.5 L 3.5 6.5 L 3.5 10.5 L 6.5 13.5 L 10.5 13.5 L 13.5 10.5 L 13.5 6.5 M 11.5 8.5 L 13.5 6.5 L 15.5 8.5";
    // Skipped: a step over.
    out property <string> skip: "M 3 8.5 L 11 8.5 M 8 5.5 L 11 8.5 L 8 11.5 M 13.5 4 L 13.5 13";
    out property <string> dot: "M 7.5 7.5 L 9.5 7.5 L 9.5 9.5 L 7.5 9.5 Z";
}

export global States {
    // A job's state: its colour and its symbol.
    public pure function colour(s: int) -> color {
        s == 1 ? Theme.ok : s == 2 ? Theme.accent : s == 3 ? Theme.warn : s == 4 ? Theme.danger : Theme.ink-3
    }
    public pure function icon(s: int) -> string {
        s == 1 ? Icons.check : s == 2 ? Icons.transfers : s == 3 || s == 4 ? Icons.alert : s == 5 ? Icons.pause : s == 6 ? Icons.x : AppIcons.clock
    }
    // A file's state: 0 waiting, 1 done, 2 in progress, 3 skipped, 4 failed, 5 waiting for an answer.
    public pure function file-colour(s: int) -> color {
        s == 1 ? Theme.ok : s == 2 ? Theme.accent : s == 4 ? Theme.danger : s == 5 ? Theme.warn : Theme.ink-3
    }
    public pure function file-icon(s: int) -> string {
        s == 1 ? Icons.check : s == 2 ? Icons.transfers : s == 3 ? AppIcons.skip : s == 4 || s == 5 ? Icons.alert : AppIcons.dot
    }
}
